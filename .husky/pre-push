#!/usr/bin/env sh
# Full suite including the browser tests.
# Skip deliberately with: SKIP_E2E=1 git push
set -e

echo "→ lint"
pnpm lint:ci

echo "→ typecheck"
pnpm typecheck

echo "→ unit + component tests"
pnpm test:unit

if [ "${SKIP_E2E:-0}" = "1" ]; then
  echo "→ playwright SKIPPED (SKIP_E2E=1)"
  exit 0
fi

echo "→ playwright (builds the app, then drives it)"
pnpm test:e2e
